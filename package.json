{
  "name": "tg-downloader-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "tsx watch src/server.ts",
    "web": "npm --prefix web run dev",
    "dev": "concurrently -n \"SERVER,WEB\" -c \"blue,green\" \"npm run server\" \"npm run web\"",
    "build": "npm --prefix web install && npm --prefix web run build && tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "telegram": "^2.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}